<div class="container-fluid px-4">
    <h2 class="mt-4 text-center text-uppercase" style="letter-spacing:4px">
        Add new Dress
    </h2>
</div>
<div class="row">
    <div class="col-md-2"></div>
    <div class="col-md-8">
        <form method="post" enctype="multipart/form-data">

            <input type="text" name="dress_name" placeholder="Enter dress name" class="form-control my-3"/>
            <input type="text" name="dress_price" placeholder="Enter dress price" class="form-control my-3" />
            <input type="text" name="dress_description" placeholder="Enter dress description" class="form-control my-3" />
            <input type="file" name="dress_image" class="form-control my-3" />
            @Html.Partial("CategoryDropdown", (List<Category>)ViewData["category"])

            <input type="submit" value="Add dress" class="form-control my-3 btn btn-primary"  />

        </form>
    </div>
    <div class="col-md-2"></div>
</div>
