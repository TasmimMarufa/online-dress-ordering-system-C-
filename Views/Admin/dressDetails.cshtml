@model Dress;
<div class="container-fluid px-4">
    <h2 class="mt-4 text-center text-uppercase" style="letter-spacing:4px">
        Dress Details
    </h2>
</div>
<div class="row">
    <div class=" col-md-2"></div>

    <div class=" col-md-8">
        <img src="@("~/dress_image/" + Model.dress_image)" asp-append-version="true"
             width="250px" height="250px" class=" my-3" />
        <ul class=" list-group">
            <li class="list-group-item">Dress Id:@Model.dress_id</li>
            <li class="list-group-item">Dress name:@Model.dress_name</li>
            <li class="list-group-item">Dress Price:@Model.dress_price</li>
            <li class="list-group-item">Dress Description:@Model.dress_description</li>
            <li class="list-group-item">Dress Category:@Model.Category.category_name</li>
         
          
        </ul>
    </div>
    <div class=" col-md-2"></div>
</div>