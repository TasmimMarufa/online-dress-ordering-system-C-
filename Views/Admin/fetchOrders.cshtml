@model List<Order>

<h2 class="mb-3">Orders</h2>

<table class="table table-bordered text-center">
    <tr>
        <th>Order Id</th>
        <th>Customer Id</th>
        <th>Date</th>
        <th>Total Amount</th>
        <th>Status</th>
    </tr>

    @foreach (var order in Model)
    {
        <tr>
            <td>@order.order_id</td>
            <td>@order.cust_id</td>
            <td>@order.order_date</td>
            <td>@order.total_amount</td>
            <td>@order.status</td>
        </tr>
    }
</table>
