@model dress_ordering_system.Models.Feedback

<div class="container-fluid px-4">
    <h2 class="mt-4 text-center text-uppercase text-danger" style="letter-spacing:4px">
        Are you sure you want to delete this Feedback?
    </h2>
</div>

<div class="row">
    <div class="col-md-2"></div>

    <div class="col-md-8">

        <ul class="list-group mb-3">
            <li class="list-group-item">
                <strong>user Id:</strong> @Model.feedback_id
            </li>
            <li class="list-group-item">
                <strong>User Name:</strong> @Model.user_name
            </li>
            <li class="list-group-item">
                <strong>user message:</strong> @Model.user_message
            </li>
        </ul>

        <form asp-action="deleteFeedback" asp-controller="Admin" method="post" class="d-inline">
            <input type="hidden" name="id" value="@Model.feedback_id" />

            <button type="submit" class="btn btn-danger">
                Delete Feedback
            </button>
        </form>


        <a href="@Url.Action("fetchFeedback", "Admin")"
           class="btn btn-warning">
            Back to List
        </a>

    </div>

    <div class="col-md-2"></div>
</div>
