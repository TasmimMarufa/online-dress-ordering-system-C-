@{
    ViewData["Title"] = "Feedback";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">

    <div class="text-center mb-5">
        <h2 class="fw-bold">Get In Touch With Us</h2>
        <p class="text-muted">We’d love to hear from you. Send us a message or find us on the map.</p>
    </div>

    <div class="row align-items-stretch shadow rounded-4 overflow-hidden">

        <!-- Contact Form -->
        <div class="col-md-5 p-5 bg-light">
            <h4 class="mb-4">Send a Message</h4>

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input type="text" class="form-control form-control-lg"
                           placeholder="Enter your full name" name="user_name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Message</label>
                    <textarea class="form-control form-control-lg" rows="5"
                              placeholder="Write your message here..." name="user_message"></textarea>
                </div>

                <button type="submit" class="btn btn-warning w-100 py-2 fw-semibold">
                    Send Message
                </button>
            </form>
        </div>

        <!-- Map Section -->
        <div class="col-md-7 p-0">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d116764.48948709838!2d90.24776969726561!3d23.858029!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3755c423ca4672bd%3A0xd6254583b5bf85a7!2sUttara%20Club!5e0!3m2!1sen!2sbd!4v1767110074833!5m2!1sen!2sbd"
                    width="100%" height="100%" style="border:0; min-height: 350px;"
                    allowfullscreen="" loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade">
            </iframe>
        </div>

    </div>
   
        
   
<h3 class="text-success">@TempData["message"]</h3>
</div>
