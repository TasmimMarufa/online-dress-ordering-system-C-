@model List<Dress>
<style>
    /* ===== FetchDress Layout Fix (Local Only) ===== */

    .block-product {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .product-thumb {
        height: 280px; /* forces same image height */
        overflow: hidden;
    }

        .product-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover; /* keeps all images proportional */
        }
</style>


<div class="container">

    <div class="row" >
        <div class="sec-tl text-center">
            <h1>Products</h1>
        </div>
    </div>

    <div class="row">

        @foreach (var pro in Model)
        {
            <div class="col-lg-3 col-md-6 col-sm-12 mb-4">

                <div class="block-product h-100">

                    <div class="product-thumb position-relative">
                        <a href="@Url.Action("DressDetails","Customer",new{id=pro.dress_id})">
                            <img src="~/dress_image/@pro.dress_image" class="img-fluid">
                        </a>

                        <div class="ad-cart position-absolute text-center">

                            <form asp-action="AddToCart" asp-controller="Customer" method="post">
                                <input type="hidden" name="dress_id" value="@pro.dress_id" />

                                <button type="submit"
                                        style="background:none;border:none;color:white;width:100%;">
                                    <span>Add to Cart</span>
                                </button>
                            </form>

                        </div>



                        <div class="product-btns position-absolute">
                            <a class="wishlist-btn" href="#"><i class="fi fi-rr-heart"></i></a>
                            <a class="cart-btn" href="#"><i class="fi-rr-shopping-bag"></i></a>
                            <a class="expand-btn" href="#"><i class="fi fi-rr-picture"></i></a>
                        </div>
                    </div>

                    <div class="product-body text-center">
                        <a href="#" class="brand-name">Dress Store</a>

                        <h2 class="product-name">
                            <a href="#">@pro.dress_name</a>
                        </h2>

                        <span class="product-price">৳ @pro.dress_price</span>
                    </div>

                </div>

            </div>

        }

    </div>
</div>

